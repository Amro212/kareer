{
  "manifest_version": 3,
  "name": "Kareer",
  "description": "Fill job application forms from your saved profile, review AI-assisted answers, and prepare tailored application documents.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content/index.js"]
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Toggle Kareer panel",
    "default_popup": "popup/index.html"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Toggle the Kareer panel"
    }
  }
}
